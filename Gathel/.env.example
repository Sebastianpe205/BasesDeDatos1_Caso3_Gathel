# Variables para docker-compose.yml. Copiar este archivo a .env
# (en la misma carpeta que docker-compose.yml) y completar los valores.
# .env NO debe subirse al repositorio -- confirma que Gathel/.gitignore
# lo excluya.

# --- SQL Server (usuario sa, solo para db-init y flyway) ---
DB_SA_PASSWORD=

# --- Nombre de la base de datos ---
DB_NAME=Gathel

# --- Login de aplicacion de bajo privilegio (creado en V17__RolesSeguridad.sql) ---
# Confirmar el nombre exacto del login con tu companero.
DB_APP_USER=
DB_APP_PASSWORD=

# --- JWT del backend ---
# Generar uno random, ej: openssl rand -hex 32
JWT_SECRET_KEY=
